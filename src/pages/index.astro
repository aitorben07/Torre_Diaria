---
import "../estilos.css";

const titulo = "Torre Diaria";
const descripcion =
  "Apila piezas con un solo toque. Juega al momento, encadena perfectos y prueba el reto de cada día, igual para todos. Gratis y sin registrarse.";
// Favicon en SVG en línea: sin archivos de imagen en dist/. Colores de la paleta «Riso» (Anexo 1, 1.2).
const favicon =
  "data:image/svg+xml," +
  encodeURIComponent(
    "<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 16 16'>" +
      "<rect width='16' height='16' fill='#F3EAD7'/>" +
      "<rect x='2' y='13' width='12' height='3' fill='#1E1B33'/>" +
      "<rect x='4' y='9' width='8' height='4' fill='#FF4F8B' stroke='#1E1B33' stroke-width='0.6'/>" +
      "<rect x='5' y='5' width='6' height='4' fill='#12A4A0' stroke='#1E1B33' stroke-width='0.6'/>" +
      "<rect x='6' y='1' width='4' height='4' fill='#FFC93C' stroke='#1E1B33' stroke-width='0.6'/>" +
      "</svg>",
  );
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{titulo}</title>
    <meta name="description" content={descripcion} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={titulo} />
    <meta property="og:description" content={descripcion} />
    <meta name="theme-color" content="#F3EAD7" />
    <link rel="icon" type="image/svg+xml" href={favicon} />
  </head>
  <body>
    <main id="juego" data-estado="inicio" data-modo="libre">
      <h1 class="solo-lectores">Torre Diaria</h1>
      <div id="zona" class="zona">
        <canvas id="lienzo" aria-label="Zona de juego: toca o pulsa Espacio para soltar la pieza"></canvas>

        {/* HUD (A5): sobre el escenario, en la columna de juego. */}
        <header id="hud" class="hud columna">
          <div id="vidas" class="vidas" role="img" aria-label="3 vidas">
            <span class="vida"></span><span class="vida"></span><span class="vida"></span>
          </div>
          <p id="hud-puntos" class="hud-puntos" aria-hidden="true">0</p>
          <p id="contador" class="solo-lectores" aria-live="polite"></p>
          <div class="lado">
            <p id="combo" class="combo" hidden></p>
            <p id="record" class="record" hidden></p>
            <p id="hud-meta" class="record meta" hidden></p>
          </div>
          {/* Pausa (E3): en el hueco que el marcador ya reservaba (A1). */}
          <button id="boton-pausa" type="button" class="icono hud-pausa" aria-label="Pausa">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path class="cuerpo" d="M7 5h3.5v14H7zM13.5 5H17v14h-3.5z" /></svg>
          </button>
        </header>
        <p id="aviso-toque" class="aviso-toque" hidden>Toca para soltar</p>
        <p id="aviso-especial" class="aviso-especial" role="status" hidden></p>

        {/* Pantalla de inicio (E2, Anexo B): monedas y ajustes arriba, el logo, «Jugar» sobre el puerto y las tarjetas. */}
        <section id="inicio" class="inicio columna" aria-label="Inicio">
          <div class="inicio-arriba">
            <button id="inicio-monedas" type="button" class="con-icono ficha-monedas" aria-label="Colección: 0 monedas">
              <svg class="moneda" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="9" /><circle class="canto" cx="12" cy="12" r="5.5" /></svg>
              <span id="inicio-monedas-numero" aria-hidden="true">0</span>
            </button>
            <button id="inicio-ajustes" type="button" class="icono" aria-label="Ajustes">
              <svg viewBox="0 0 24 24" aria-hidden="true">
                <path class="rueda" d="M10.3 2.5h3.4l.5 2.6 1.7.7 2.2-1.5 2.4 2.4-1.5 2.2.7 1.7 2.6.5v3.4l-2.6.5-.7 1.7 1.5 2.2-2.4 2.4-2.2-1.5-1.7.7-.5 2.6h-3.4l-.5-2.6-1.7-.7-2.2 1.5-2.4-2.4 1.5-2.2-.7-1.7-2.6-.5v-3.4l2.6-.5.7-1.7-1.5-2.2 2.4-2.4 2.2 1.5 1.7-.7z" />
                <circle cx="12" cy="12" r="3.2" />
              </svg>
            </button>
          </div>
          {/* Logo provisional en texto hasta el bloque G; el título para lectores es el <h1>. */}
          <p class="logo" aria-hidden="true"><span>Torre</span><span>Diaria</span></p>
          <div class="inicio-abajo">
            <p id="inicio-siguiente" class="siguiente" hidden></p>
            <button id="inicio-jugar" type="button" class="principal jugar">Jugar</button>
            <div class="tarjetas">
              <button id="tarjeta-reto" type="button" class="tarjeta" aria-label="Reto de hoy">
                <span class="tarjeta-cabeza" aria-hidden="true">
                  <svg class="llama" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2c1 4 6 6 6 12a6 6 0 0 1-12 0c0-3 2-5 3-6 0 2 1 3 2 3 0-4-1-6 1-9z" /></svg>
                  <span id="tarjeta-racha" class="tarjeta-cifra">0</span>
                </span>
                <span class="tarjeta-nombre" aria-hidden="true">Reto de hoy</span>
                <span class="tarjeta-estado" aria-hidden="true"><span id="tarjeta-reto-marca" class="punto"></span><span id="tarjeta-reto-texto">Sin jugar</span></span>
              </button>
              <button id="tarjeta-niveles" type="button" class="tarjeta" aria-label="Niveles">
                <span class="tarjeta-cabeza" aria-hidden="true">
                  <svg class="estrella llena" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2.6l2.8 5.9 6.5.8-4.8 4.5 1.2 6.4L12 17l-5.7 3.2 1.2-6.4-4.8-4.5 6.5-.8z" /></svg>
                  <span id="tarjeta-estrellas" class="tarjeta-cifra">0</span>
                </span>
                <span class="tarjeta-nombre" aria-hidden="true">Niveles</span>
                <span id="tarjeta-nivel" class="tarjeta-estado" aria-hidden="true">Nivel 1</span>
              </button>
              <button id="tarjeta-coleccion" type="button" class="tarjeta" aria-label="Colección: piezas y escenarios">
                <span class="tarjeta-cabeza" aria-hidden="true">
                  <svg class="bolsa" viewBox="0 0 24 24" aria-hidden="true"><path d="M5 8h14l-1 13H6zM9 8V6a3 3 0 0 1 6 0v2" /></svg>
                </span>
                <span class="tarjeta-nombre" aria-hidden="true">Colección</span>
                <span class="tarjeta-estado" aria-hidden="true">Piezas y escenarios</span>
              </button>
            </div>
          </div>
        </section>

        {/* Pausa (E3): en el reto diario, sin «Inicio» (impacto §5, R-3). */}
        <section id="pausa" class="panel columna pausa" aria-labelledby="pausa-titulo" hidden>
          <h2 id="pausa-titulo">Pausa</h2>
          <p id="pausa-texto" class="suave"></p>
          <div class="acciones">
            <button id="boton-seguir" type="button" class="principal">Seguir</button>
            <button id="pausa-ajustes" type="button">Ajustes</button>
            <button id="pausa-inicio" type="button">Inicio</button>
          </div>
        </section>

        <section id="reto" class="panel columna" aria-labelledby="reto-titulo" hidden>
          <h2 id="reto-titulo">Reto de un amigo</h2>
          <p id="aviso-reto" class="destacado"></p>
          <p id="comparacion" class="destacado" hidden></p>
          <button id="boton-reto" type="button" class="principal">Jugar el reto</button>
          <button id="boton-repetir-reto" type="button" hidden>Jugar otra vez (no cuenta)</button>
          <button id="boton-libre-reto" type="button">Partida libre</button>
        </section>

        <section id="fin" class="panel columna" aria-labelledby="fin-titulo" hidden>
          <h2 id="fin-titulo"></h2>
          <p class="marcador" aria-hidden="true"><span id="fin-numero" class="numero"></span> <span id="fin-unidad"></span></p>
          <p id="fin-puntos" class="solo-lectores"></p>
          <p class="datos"><span id="fin-altura"></span><span id="fin-record" hidden></span></p>
          {/* Fin de un nivel (E3): objetivo y estrellas, que aparecen una a una. */}
          <div id="fin-nivel" class="fin-nivel" hidden>
            <p id="fin-objetivo" class="objetivo"></p>
            <div id="fin-estrellas" class="estrellas grandes" role="img"></div>
          </div>
          {/* Premios (C2, D1): sello de récord, medalla y racha, monedas ganadas, desbloqueo y siguiente objetivo. */}
          <div class="premios">
            <p id="fin-nuevo-record" class="sello" hidden>¡Nuevo récord!</p>
            <p id="fin-medalla" class="premio" hidden><span id="fin-medalla-icono" class="medalla" aria-hidden="true"></span><span id="fin-medalla-texto"></span></p>
            <p id="fin-monedas" class="premio" hidden>
              <svg class="moneda" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="9" /><circle class="canto" cx="12" cy="12" r="5.5" /></svg>
              <span id="fin-monedas-numero"></span>
              <span id="fin-monedas-texto" class="solo-lectores"></span>
            </p>
          </div>
          <div id="fin-desbloqueo" class="desbloqueo" hidden>
            <canvas id="fin-desbloqueo-muestra" class="muestra" aria-hidden="true"></canvas>
            <p id="fin-desbloqueo-texto"></p>
            <button id="boton-equipar-nuevo" type="button">Usar</button>
          </div>
          <p id="fin-reto" class="destacado" hidden></p>
          <p id="fin-siguiente" class="siguiente" hidden></p>
          <div class="acciones">
            <button id="boton-otra-vez" type="button" class="principal">Otra vez</button>
            <button id="boton-repetir-nivel" type="button" hidden>Repetir</button>
            <button id="boton-mapa" type="button" hidden>Mapa</button>
            <button id="boton-libre-nivel" type="button" hidden>Partida libre</button>
            <button id="boton-inicio" type="button">Inicio</button>
          </div>
          {/* Compartir (F1, F3): vista previa de la imagen en un canvas (no <img>, S17), el texto y sus botones. */}
          <div class="compartir">
            <canvas id="fin-imagen" class="vista-imagen" role="img" aria-label="Vista previa de la imagen para compartir"></canvas>
            <pre id="tarjeta" aria-label="Vista previa de la tarjeta"></pre>
            <div class="acciones compartir-botones">
              <button id="boton-compartir" type="button" hidden>Compartir</button>
              <button id="boton-descargar" type="button">Descargar imagen</button>
              <button id="boton-copiar" type="button">Copiar texto</button>
            </div>
          </div>
          <p id="mensaje" role="status"></p>
        </section>

        {/* Retos diarios (D2): racha y congeladores, ficha del día elegido (al abrir, hoy) y calendario. */}
        <section id="retos" class="panel columna" aria-labelledby="retos-titulo" hidden>
          <div class="cabecera">
            <h2 id="retos-titulo">Retos diarios</h2>
            <button id="cerrar-retos" type="button" class="icono" aria-label="Cerrar">
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18" /></svg>
            </button>
          </div>
          <div class="racha">
            <svg class="llama" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2c1 4 6 6 6 12a6 6 0 0 1-12 0c0-3 2-5 3-6 0 2 1 3 2 3 0-4-1-6 1-9z" /></svg>
            <p><span id="racha-actual" class="cifra">0</span> <span id="racha-unidad">días de racha</span><br /><span id="racha-mejor" class="suave"></span></p>
            <div id="congeladores" class="congeladores" role="img" aria-label="0 congeladores">
              <span class="congelador"></span><span class="congelador"></span>
            </div>
          </div>
          <div class="racha-pie">
            <button id="comprar-congelador" type="button">Congelador de racha</button>
            <p id="racha-siguiente" class="siguiente" hidden></p>
          </div>
          <div id="ficha" class="ficha">
            <h3 id="ficha-titulo"></h3>
            <p id="ficha-estado" class="premio"><span id="ficha-medalla" class="medalla" aria-hidden="true" hidden></span><span id="ficha-texto"></span></p>
            <div class="acciones">
              <button id="ficha-jugar" type="button" class="principal">Jugar</button>
              <button id="ficha-compartir" type="button">Compartir</button>
              <button id="ficha-descargar" type="button">Descargar imagen</button>
              <button id="ficha-repetir" type="button">Jugar otra vez (no cuenta)</button>
            </div>
            <p id="ficha-mensaje" role="status"></p>
          </div>
          <div class="mes">
            <button id="mes-anterior" type="button" class="icono" aria-label="Mes anterior">
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M15 5l-7 7 7 7" /></svg>
            </button>
            <h3 id="mes-nombre"></h3>
            <button id="mes-siguiente" type="button" class="icono" aria-label="Mes siguiente">
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M9 5l7 7-7 7" /></svg>
            </button>
          </div>
          <div class="semana" aria-hidden="true"><span>L</span><span>M</span><span>X</span><span>J</span><span>V</span><span>S</span><span>D</span></div>
          <div id="calendario" class="calendario"></div>
        </section>

        {/* Niveles (E3): ficha del nivel elegido y mapa del Puerto, de abajo arriba, con el camino en zigzag. */}
        <section id="niveles" class="panel columna" aria-labelledby="niveles-titulo" hidden>
          <div class="cabecera">
            <h2 id="niveles-titulo">Niveles · Puerto</h2>
            <p class="saldo">
              <svg class="estrella llena" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2.6l2.8 5.9 6.5.8-4.8 4.5 1.2 6.4L12 17l-5.7 3.2 1.2-6.4-4.8-4.5 6.5-.8z" /></svg>
              <span id="niveles-estrellas">0</span><span id="niveles-estrellas-total" class="suave"></span><span class="solo-lectores"> estrellas</span>
            </p>
            <button id="cerrar-niveles" type="button" class="icono" aria-label="Cerrar">
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18" /></svg>
            </button>
          </div>
          <div id="ficha-nivel" class="ficha ficha-nivel">
            <div class="ficha-nivel-cabeza">
              <h3 id="ficha-nivel-titulo"></h3>
              <div id="ficha-nivel-estrellas" class="estrellas" role="img"></div>
            </div>
            <p id="ficha-nivel-objetivo" class="objetivo"></p>
            <p id="ficha-nivel-detalle" class="suave"></p>
            <button id="ficha-nivel-jugar" type="button" class="principal">Jugar</button>
          </div>
          <div id="mapa" class="mapa">
            <div class="mapa-camino">
              <div class="mapa-cielo" aria-hidden="true">
                <svg class="nube n1" aria-hidden="true" viewBox="0 0 48 24"><path d="M10 21a6 6 0 0 1 0-12 9 9 0 0 1 17-3 7 7 0 0 1 12 4 5.5 5.5 0 0 1 0 11z" /></svg>
                <svg class="nube n2" aria-hidden="true" viewBox="0 0 48 24"><path d="M10 21a6 6 0 0 1 0-12 9 9 0 0 1 17-3 7 7 0 0 1 12 4 5.5 5.5 0 0 1 0 11z" /></svg>
                <svg class="nube n3" aria-hidden="true" viewBox="0 0 48 24"><path d="M10 21a6 6 0 0 1 0-12 9 9 0 0 1 17-3 7 7 0 0 1 12 4 5.5 5.5 0 0 1 0 11z" /></svg>
                <svg class="nube n4" aria-hidden="true" viewBox="0 0 48 24"><path d="M10 21a6 6 0 0 1 0-12 9 9 0 0 1 17-3 7 7 0 0 1 12 4 5.5 5.5 0 0 1 0 11z" /></svg>
                <svg class="gaviota g1" aria-hidden="true" viewBox="0 0 24 10"><path d="M2 7q5-6 10 0q5-6 10 0" /></svg>
                <svg class="gaviota g2" aria-hidden="true" viewBox="0 0 24 10"><path d="M2 7q5-6 10 0q5-6 10 0" /></svg>
                <svg class="gaviota g3" aria-hidden="true" viewBox="0 0 24 10"><path d="M2 7q5-6 10 0q5-6 10 0" /></svg>
                <svg class="globo b1" aria-hidden="true" viewBox="0 0 24 34"><path class="tela" d="M12 2a10 10 0 0 0-10 10c0 6 6 10 8 14h4c2-4 8-8 8-14A10 10 0 0 0 12 2z" /><path class="franja" d="M12 2c-3 3-4 7-4 10s1 9 2 14h4c1-5 2-11 2-14s-1-7-4-10z" /><path d="M10 27h4v5h-4z" /></svg>
                <svg class="globo b2" aria-hidden="true" viewBox="0 0 24 34"><path class="tela" d="M12 2a10 10 0 0 0-10 10c0 6 6 10 8 14h4c2-4 8-8 8-14A10 10 0 0 0 12 2z" /><path class="franja" d="M12 2c-3 3-4 7-4 10s1 9 2 14h4c1-5 2-11 2-14s-1-7-4-10z" /><path d="M10 27h4v5h-4z" /></svg>
              </div>
              <svg id="mapa-sendero" class="sendero" aria-hidden="true" preserveAspectRatio="none"></svg>
              <ol id="mapa-niveles" class="mapa-niveles" aria-label="Mapa de niveles"></ol>
            </div>
            {/* El Puerto al pie del mapa, dibujado en SVG (sin imágenes en dist/, G8). */}
            <svg class="mapa-puerto" viewBox="0 0 120 44" preserveAspectRatio="xMidYMax slice" aria-hidden="true">
              <circle class="sol" cx="30" cy="22" r="11" />
              <circle class="sol-registro" cx="31.5" cy="21" r="11" />
              <path class="siluetas" d="M6 30V12h2v-3h14v2H10v1h2v18zM84 30v-9l3-2 3 2v9zM92 30v-6h10v6zM104 30l2-10h2l2 10z" />
              <path class="agua" d="M0 30q5-2 10 0t10 0 10 0 10 0 10 0 10 0 10 0 10 0 10 0 10 0 10 0 10 0V44H0z" />
              <path class="espuma" d="M4 35q3-1.5 6 0M30 38q3-1.5 6 0M62 34q3-1.5 6 0M92 39q3-1.5 6 0" />
              <rect class="muelle" x="38" y="27" width="44" height="4" rx="0.6" />
              <path class="pilotes" d="M42 31v8M52 31v8M68 31v8M78 31v8" />
            </svg>
          </div>
        </section>

        {/* Colección (C3): temas de piezas y escenarios, con muestra dibujada, precio o condición. */}
        <section id="coleccion" class="panel columna" aria-labelledby="coleccion-titulo" hidden>
          <div class="cabecera">
            <h2 id="coleccion-titulo">Colección</h2>
            <p class="saldo">
              <svg class="moneda" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="9" /><circle class="canto" cx="12" cy="12" r="5.5" /></svg>
              <span id="coleccion-monedas">0</span><span class="solo-lectores"> monedas</span>
            </p>
            <button id="cerrar-coleccion" type="button" class="icono" aria-label="Cerrar">
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18" /></svg>
            </button>
          </div>
          <div class="pestanas" role="tablist" aria-label="Tipo">
            <button id="pestana-piezas" type="button" role="tab" aria-selected="true" aria-controls="articulos">Piezas</button>
            <button id="pestana-escenarios" type="button" role="tab" aria-selected="false" aria-controls="articulos">Escenarios</button>
          </div>
          <ul id="articulos" class="articulos" role="tabpanel"></ul>
          <p id="coleccion-mensaje" role="status"></p>
        </section>

        {/* Ajustes (C2, Anexo C con impacto §5): interruptores, créditos con la privacidad y la versión. */}
        <section id="ajustes" class="panel columna" aria-labelledby="ajustes-titulo" hidden>
          <div class="cabecera">
            <h2 id="ajustes-titulo">Ajustes</h2>
            <button id="cerrar-ajustes" type="button" class="icono" aria-label="Cerrar">
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18" /></svg>
            </button>
          </div>
          <div class="interruptores">
            <button id="ajuste-musica" type="button" role="switch" aria-checked="true" class="interruptor">
              <span>Música</span><span class="pildora" aria-hidden="true"></span>
            </button>
            <button id="ajuste-sonidos" type="button" role="switch" aria-checked="true" class="interruptor">
              <span>Sonidos</span><span class="pildora" aria-hidden="true"></span>
            </button>
            <button id="ajuste-vibracion" type="button" role="switch" aria-checked="true" class="interruptor" hidden>
              <span>Vibración</span><span class="pildora" aria-hidden="true"></span>
            </button>
          </div>
          <button id="boton-creditos" type="button" aria-expanded="false" aria-controls="creditos">Créditos y licencias</button>
          <div id="creditos" class="creditos" hidden>
            <p>Letra: Bricolage Grotesque (OFL-1.1).</p>
            <p>Física: planck (MIT).</p>
            <p>Música original compuesta en código para Torre Diaria. Sonidos sintetizados en código.</p>
            <p><strong>Privacidad.</strong> Todo se guarda solo en este navegador. No hay cuentas, ni cookies de terceros, ni anuncios.</p>
          </div>
          <p id="ajustes-version" class="suave"></p>
        </section>

        <div id="grano" class="grano" aria-hidden="true"></div>
      </div>
    </main>
    <script>
      import "../juego/principal.ts";
    </script>
  </body>
</html>
